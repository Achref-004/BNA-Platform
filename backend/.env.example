# ============================================================
# Copie ce fichier vers .env et adapte localement les valeurs
# ------------------------------------------------------------
PORT=5000
JWT_SECRET=change-me-production
JWT_EXPIRES_IN=7d

# Frontend (liens inclus dans emails)
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_LOGIN_URL=http://localhost:3000/login

# SQL Server pools (voir config/db.js pour la liste complète)
DB_SERVER=localhost
DB_USER=...
DB_PASSWORD=...
DB_NAME_AUTH=BNA
DB_NAME_DW=DW_BNA_Placements

# SMTP (si absent ou SMTP_DISABLED=true les emails sont ignorés côté app)
SMTP_DISABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey-or-user
SMTP_PASS=secret
SMTP_FROM="BNA Espace placements <noreply@example.tn>"

# Groq (chat IA)
GROQ_API_KEY=

# AI Forecasting (Python)
PYTHON_PATH=python
# FORECAST_OUTPUT_DIR=./data/forecast/outputs
# FORECAST_UPLOAD_DIR=./data/forecast/uploads
